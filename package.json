{
    "name": "@cyronius/lm-ag-ui",
    "version": "1.0.276",
    "description": "React hooks and utilities for building chat interfaces powered by the AG-UI streaming protocol.",
    "license": "MIT",
    "author": "Cyrus Attoun",
    "homepage": "https://github.com/Cyronius/lm-ag-ui#readme",
    "bugs": {
        "url": "https://github.com/Cyronius/lm-ag-ui/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Cyronius/lm-ag-ui.git"
    },
    "keywords": [
        "ag-ui",
        "agent",
        "react",
        "hooks",
        "streaming",
        "chat",
        "llm",
        "tool-calling"
    ],
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist/**"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "vite build",
        "test": "vitest run",
        "prepare": "vite build"
    },
    "dependencies": {
        "uuid": "^11.1.1"
    },
    "peerDependencies": {
        "@ag-ui/client": "^0.0.47",
        "@ag-ui/core": "^0.0.47",
        "react": ">=18",
        "rxjs": "^7.8.0"
    },
    "devDependencies": {
        "@ag-ui/client": "^0.0.47",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@types/uuid": "^10.0.0",
        "@vitejs/plugin-react-swc": "^3.10.2",
        "happy-dom": "^20.9.0",
        "react": ">=18",
        "react-dom": "^18.0.0",
        "rollup-plugin-visualizer": "^6.0.5",
        "rxjs": "^7.8.2",
        "typescript": "^5.0.0",
        "vite": "^6.4.1",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^4.1.5"
    }
}
